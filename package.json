{
  "name": "gex",
  "version": "1.0.0",
  "description": "GEX",
  "source": "src/index.html",
  "scripts": {
    "clean": "rimraf -rf dist",
    "ncp": "mkdir -p dist && ncp api dist/api",
    "build-github-pages": "npm run build -- --public-url=/gex/",
    "preserve": "npm run ncp",
    "serve": "parcel --no-cache --no-source-maps --port ${APP_PORT:-1234}",
    "serve:proxy": "bun ./scripts/options-local-proxy.ts",
    "build": "parcel build --no-cache --no-source-maps",
    "postbuild": "npm run ncp",
    "app": "bun ./scripts/check-ports.ts app && npm run serve",
    "proxy": "bun ./scripts/check-ports.ts proxy && npm run serve:proxy",
    "all": "bun ./scripts/check-ports.ts all && npm-run-all --parallel serve serve:proxy",
    "start": "bun ./scripts/check-ports.ts all && pm2 start 'npm run all' --name app",
    "restart": "pm2 restart app",
    "ps": "pm2 ps",
    "logs": "pm2 logs",
    "stop": "pm2 kill",
    "test": "bun test",
    "backtest:backup": "bun scripts/backtest-backup.ts",
    "test:e2e": "bun src/e2e-run.ts",
    "data:setup": "bun scripts/data-local.ts setup",
    "data:status": "bun scripts/data-local.ts status",
    "data:logs": "bun scripts/data-local.ts logs",
    "data:run": "bun scripts/data-local.ts run",
    "data:pause": "bun scripts/data-local.ts pause",
    "data:resume": "bun scripts/data-local.ts resume",
    "data:uninstall": "bun scripts/data-local.ts uninstall",
    "data:help": "bun scripts/data-local.ts help",
    "tv:session": "bun scripts/tv/session.ts",
    "tv:check": "bun scripts/tv/check.ts",
    "tv:futures": "bun scripts/tv/futures.ts"
  },
  "keywords": [
    "npm-run-all",
    "tailwind",
    "parcel",
    "rimraf",
    "react",
    "html",
    "pm2",
    "css",
    "ncp",
    "bun"
  ],
  "author": "Maksim Kostromin / GitHub: daggerok",
  "license": "MIT",
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@parcel/resolver-default": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ncp": "2.0.0",
    "npm-run-all": "4.1.5",
    "papaparse": "5.7.0",
    "parcel": "2.16.4",
    "playwright": "1.63.0",
    "pm2": "7.0.4",
    "rimraf": "6.1.3"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
